# Server Port (default: 3000)
PORT=3000

# Client URL for CORS (comma-separated for multiple origins, or * in dev)
# Example for production: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=*

# Frontend connection to backend Socket.IO server
# Leave empty or set to http://localhost:3000 in dev
# Set to https://your-backend-service.onrender.com for production deployment
VITE_SERVER_URL=http://localhost:3000

# Optional: Redis URL for horizontal scaling across multiple instances
# REDIS_URL=redis://default:password@your-redis-host:6379

# Scalability & Resource Limits
MAX_PLAYERS_PER_ROOM=5
MAX_ACTIVE_ROOMS=1000
ROOM_TTL_MS=7200000
INACTIVE_ROOM_TIMEOUT_MS=1800000
RECONNECT_GRACE_PERIOD_MS=60000

# Optional: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
